{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "High Contrast",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				},
				{
					"slug": "black",
					"color": "#000000",
					"name": "Black"
				},
				{
					"slug": "transparent",
					"color": "transparent",
					"name": "Transparent"
				},
				{
					"slug": "background",
					"color": "#000000",
					"name": "Background"
				},
				{
					"slug": "foreground",
					"color": "#ffffff",
					"name": "Foreground"
				},
				{
					"slug": "primary",
					"color": "#ffff00",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#ffffff",
					"name": "Secondary"
				},
				{
					"slug": "muted",
					"color": "#e6e6e6",
					"name": "Muted"
				},
				{
					"slug": "border",
					"color": "#ffffff",
					"name": "Border"
				},
				{
					"slug": "light",
					"color": "#000000",
					"name": "Light"
				},
				{
					"slug": "dark",
					"color": "#000000",
					"name": "Dark"
				},
				{
					"slug": "accent",
					"color": "#00ffff",
					"name": "Accent"
				}
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"color": {
					"text": "var(--wp--preset--color--black)"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			}
		}
	}
}
