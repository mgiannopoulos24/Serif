			},
			"core/post-comments-form": {
				"css": "& input:not([type=submit]):not([type=checkbox]),& textarea{border:1px solid var(--wp--preset--color--muted);border-radius:4px;padding:8px 12px;background:var(--wp--preset--color--background);color:var(--wp--preset--color--foreground);font:inherit;width:100%;max-width:100%;}"
			},
			"core/post-excerpt": {
				"color": {
					"text": "var(--wp--preset--color--secondary)"
