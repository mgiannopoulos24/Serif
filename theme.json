{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				},
				{
					"slug": "black",
					"color": "#000000",
					"name": "Black"
				},
				{
					"slug": "transparent",
					"color": "transparent",
					"name": "Transparent"
				},
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "Background"
				},
				{
					"slug": "foreground",
					"color": "#111111",
					"name": "Foreground"
				},
				{
					"slug": "primary",
					"color": "#b91c1c",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#4b5563",
					"name": "Secondary"
				},
				{
					"slug": "muted",
					"color": "#6b7280",
					"name": "Muted"
				},
				{
					"slug": "border",
					"color": "#e5e7eb",
					"name": "Border"
				},
				{
					"slug": "light",
					"color": "#f3f4f6",
					"name": "Light"
				},
				{
					"slug": "dark",
					"color": "#1f2937",
					"name": "Dark"
				},
				{
					"slug": "accent",
					"color": "#2563eb",
					"name": "Accent"
				}
			],
			"duotone": [
				{
					"slug": "grayscale",
					"name": "Grayscale",
					"colors": [ "#111111", "#ffffff" ]
				},
				{
					"slug": "warm",
					"name": "Warm",
					"colors": [ "#5c4033", "#fbf7f0" ]
				},
				{
					"slug": "cool",
					"name": "Cool",
					"colors": [ "#1e3a5f", "#e8f0fe" ]
				},
				{
					"slug": "editorial",
					"name": "Editorial",
					"colors": [ "#111111", "#b91c1c" ]
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"IBM Plex Serif\", Georgia, \"Times New Roman\", serif",
					"slug": "ibm-plex-serif",
					"name": "IBM Plex Serif",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Serif",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/IBMPlexSerif-Regular.woff2" ]
						},
						{
							"fontFamily": "IBM Plex Serif",
							"fontWeight": "400",
							"fontStyle": "italic",
							"src": [ "file:./assets/fonts/IBMPlexSerif-Italic.woff2" ]
						},
						{
							"fontFamily": "IBM Plex Serif",
							"fontWeight": "700",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/IBMPlexSerif-Bold.woff2" ]
						}
					]
				},
				{
					"fontFamily": "\"IBM Plex Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif",
					"slug": "ibm-plex-sans",
					"name": "IBM Plex Sans",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Sans",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/IBMPlexSans.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "14px",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "16px",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "20px",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "28px",
					"name": "X-Large"
				},
				{
					"slug": "xx-large",
					"size": "36px",
					"name": "XX-Large"
				},
				{
					"slug": "xxx-large",
					"size": "48px",
					"name": "XXX-Large"
				}
			],
			"dropCap": true,
			"fluid": true
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw" ],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"layout": {
			"contentSize": "900px",
			"wideSize": "1280px"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"dropCap": true,
					"lineHeight": true
				}
			},
			"core/heading": {
				"typography": {
					"lineHeight": true,
					"fontWeight": true
				}
			},
			"core/image": {
				"border": {
					"radius": true
				}
			},
			"core/cover": {
				"color": {
					"duotone": true
				},
				"spacing": {
					"padding": true
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": true
				}
			},
			"core/quote": {
				"typography": {
					"fontSize": true,
					"fontStyle": true,
					"lineHeight": true
				},
				"border": {
					"color": true,
					"style": true,
					"width": true
				},
				"spacing": {
					"padding": true
				}
			},
			"core/pullquote": {
				"typography": {
					"fontSize": true,
					"fontStyle": true,
					"lineHeight": true
				},
				"border": {
					"color": true,
					"style": true,
					"width": true
				},
				"spacing": {
					"padding": true
				}
			},
			"core/separator": {
				"border": {
					"color": true,
					"style": true,
					"width": true
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": true,
					"fontWeight": true,
					"textTransform": true
				}
			},
			"core/site-logo": {},
			"core/site-title": {
				"typography": {
					"fontSize": true,
					"fontWeight": true,
					"lineHeight": true
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": true,
					"fontWeight": true,
					"lineHeight": true
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ibm-plex-serif)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--foreground)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
					"fontWeight": "600",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "var(--wp--preset--color--foreground)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"border": {
					"radius": "4px"
				},
				"spacing": {
					"padding": {
						"top": "12px",
						"right": "24px",
						"bottom": "12px",
						"left": "24px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)"
				}
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"core/quote": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "italic",
					"lineHeight": "1.6"
				},
				"color": {
					"text": "var(--wp--preset--color--foreground)",
					"background": "var(--wp--preset--color--light)"
				},
				"spacing": {
					"padding": {
						"top": "24px",
						"right": "24px",
						"bottom": "24px",
						"left": "24px"
					}
				},
				"border": {
					"left": {
						"color": "var(--wp--preset--color--primary)",
						"style": "solid",
						"width": "4px"
					}
				}
			},
			"core/pullquote": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontStyle": "italic",
					"lineHeight": "1.4"
				},
				"color": {
					"text": "var(--wp--preset--color--foreground)",
					"background": "var(--wp--preset--color--light)"
				},
				"spacing": {
					"padding": {
						"top": "32px",
						"right": "32px",
						"bottom": "32px",
						"left": "32px"
					}
				},
				"border": {
					"top": {
						"color": "var(--wp--preset--color--primary)",
						"style": "solid",
						"width": "4px"
					},
					"bottom": {
						"color": "var(--wp--preset--color--primary)",
						"style": "solid",
						"width": "4px"
					}
				}
			},
			"core/separator": {
				"border": {
					"color": "var(--wp--preset--color--border)",
					"style": "solid",
					"width": "0",
					"top": {
						"width": "1px"
					}
				}
			},
			"core/image": {
				"border": {
					"radius": "4px"
				}
			},
			"core/cover": {
				"color": {
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				},
				"spacing": {
					"padding": {
						"top": "48px",
						"right": "32px",
						"bottom": "48px",
						"left": "32px"
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500"
				}
			},
			"core/site-logo": {
				"spacing": {
					"padding": {
						"right": "8px"
					}
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "4px"
				}
			}
		},
		"spacing": {
			"padding": {
				"left": "20px",
				"right": "20px",
				"top": "0",
				"bottom": "0"
			}
		}
	},
	"customTemplates": [
		{
			"name": "blank",
			"title": "Blank (Full Width)",
			"postTypes": [ "page", "post" ]
		}
	],
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
